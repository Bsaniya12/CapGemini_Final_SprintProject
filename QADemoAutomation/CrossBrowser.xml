<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="QA Demo Cross Browser Suite"
       parallel="tests"
       thread-count="3">

    <test name="Chrome Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="qademo.tests.Login.ValidLogin_Test"/>
            <class name="qademo.tests.Product.ProductListing_Test"/>
            <class name="qademo.tests.Product.ProductDetails_Test"/>
            <class name="qademo.tests.Order.OrderHistory_Test"/>
        </classes>
    </test>

    <test name="Firefox Tests">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="qademo.tests.Login.ValidLogin_Test"/>
            <class name="qademo.tests.Product.ProductListing_Test"/>
            <class name="qademo.tests.Product.ProductDetails_Test"/>
            <class name="qademo.tests.Order.OrderHistory_Test"/>
        </classes>
    </test>

    <test name="Edge Tests">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="qademo.tests.Login.ValidLogin_Test"/>
            <class name="qademo.tests.Product.ProductListing_Test"/>
            <class name="qademo.tests.Product.ProductDetails_Test"/>
            <class name="qademo.tests.Order.OrderHistory_Test"/>
        </classes>
    </test>

</suite>
